---
interface Props {
  name: string;
  price: string;
  description: string;
  notIncluded: string;
}

const { name, price, description, notIncluded } = Astro.props;
---
<article class="flex flex-col rounded-xl bg-white border border-near-black/10 p-6 pt-5 h-full">
  <div class="w-10 border-t-2 border-amber mb-5" aria-hidden="true"></div>
  <h3 class="text-2xl font-light tracking-wide text-near-black leading-snug" style="font-family: var(--font-display)">
    {name}
  </h3>
  <p class="text-3xl font-light text-amber mt-2 mb-4" style="font-family: var(--font-display)">
    {price}
  </p>
  <p class="text-near-black/80 leading-relaxed text-sm flex-1">
    {description}
  </p>
  <p class="text-near-black/40 text-xs leading-relaxed mt-6">
    Not included: {notIncluded}
  </p>
</article>
