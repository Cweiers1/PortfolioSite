---
interface Props {
  name: string;
  tags: string[];
  href?: string;
  icon?: string;
}

const { name, tags, href = '#', icon } = Astro.props;

const iconColorMap: Record<string, string> = {
  '{ }': 'bg-dark-olive text-warm-white',
  'UI':  'bg-near-black text-warm-white',
  '>_':  'bg-deep-rose text-warm-white',
  'JS':  'bg-amber text-near-black',
  'API': 'bg-deep-rose text-warm-white',
};
const previewClass = icon
  ? (iconColorMap[icon] ?? 'bg-near-black text-warm-white')
  : 'bg-dark-olive text-warm-white';
---
<a href={href} class="project-card bg-warm-white/75 rounded-xl p-4 flex flex-col gap-3 hover:shadow-md transition-shadow">
  <div class="project-card__inner flex flex-col gap-3">
    <div class={`${previewClass} rounded-lg h-32 flex items-center justify-center`}>
      {icon ? (
        <span class="text-4xl font-mono">{icon}</span>
      ) : (
        <span class="text-sm font-medium">Screenshot</span>
      )}
    </div>
    <p class="font-bold text-near-black">{name}</p>
    <div class="flex flex-wrap gap-1.5">
      {tags.map(tag => (
        <span class="bg-warm-white border border-near-black/20 text-near-black text-xs px-2.5 py-0.5 rounded-full">
          {tag}
        </span>
      ))}
    </div>
  </div>
</a>

<style>
  .project-card {
    /* perspective on the element itself drives the 3D dip */
    transform: perspective(900px) rotateX(0) rotateY(0) scale(1);
    transform-style: preserve-3d;
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 350ms ease;
    will-change: transform;
  }

  /* content lifts toward the viewer while the card dips under the cursor,
     exaggerating the "weighed down" read */
  .project-card__inner {
    transform: translateZ(0);
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project-card:hover .project-card__inner {
    transform: translateZ(24px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card__inner {
      transform: none !important;
      transition: none;
    }
  }
</style>

<script>
  const MAX_TILT = 10; // degrees — how far the card dips

  document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      // normalized cursor position, -0.5 (top/left) … 0.5 (bottom/right)
      const px = (e.clientX - r.left) / r.width - 0.5;
      const py = (e.clientY - r.top) / r.height - 0.5;

      // dip TOWARD the cursor: the side under the mouse recedes,
      // the opposite side rises and reads as larger
      const rotateY = px * MAX_TILT;   // cursor right → right edge sinks
      const rotateX = -py * MAX_TILT;  // cursor bottom → bottom edge sinks

      card.style.transform =
        `perspective(900px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
    });

    card.addEventListener('pointerleave', () => {
      card.style.transform = 'perspective(900px) rotateX(0) rotateY(0) scale(1)';
    });
  });
</script>
