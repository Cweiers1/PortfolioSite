---
interface Props {
  name: string;
  description: string;
  outcome: string;
  tag: string;
}

const { name, description, outcome, tag } = Astro.props;
---
<article class="flex flex-col rounded-xl bg-warm-white p-6 pt-5 h-full">
  <div class="w-10 border-t-2 border-amber mb-5" aria-hidden="true"></div>
  <span class="self-start text-[0.65rem] tracking-widest uppercase text-dark-olive bg-dark-olive/10 px-2.5 py-0.5 rounded-full mb-3">
    {tag}
  </span>
  <h3 class="font-semibold text-near-black text-base leading-snug mb-2">{name}</h3>
  <p class="text-near-black/75 text-sm leading-relaxed mb-4">{description}</p>
  <p class="text-near-black/55 text-sm leading-relaxed mt-auto">
    <span class="text-dark-olive font-medium">Outcome:</span> {outcome}
  </p>
</article>
