---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ContactForm from '../components/ContactForm.astro';
import corkboard from '../assets/cork-board.png';

const skillGroups = [
  { category: 'Frontend',              skills: ['TypeScript', 'React', 'Tailwind CSS', 'Astro'] },
  { category: 'Backend & Data',        skills: ['', 'Node.js', 'REST APIs'] },
  { category: 'Tooling & Automation',  skills: ['Power Automate', 'Office Scripts', 'GitHub'] },
];
---
<BaseLayout
  title="Cass Weiers · Websites & automations for West Michigan"
  description="Fixed-price websites and simple automations for Grand Rapids-area small businesses and nonprofits. Based in Comstock Park."
>

  <!-- Hero -->
  <section class="relative bg-dark-olive py-32 px-8 overflow-hidden" style="clip-path: polygon(0 0, 100% 0, 100% calc(100% - 60px), 0 100%)">
    <div class="absolute inset-0 opacity-15" style={`background-image: url('${corkboard.src}'); background-repeat: repeat;`} aria-hidden="true"></div>
    <div class="relative z-10 sm:max-w-5xl max-w-3xl mx-auto">
      <p class="text-amber text-xs tracking-widest uppercase mb-6">Comstock Park · West Michigan</p>
      <h1 class="text-[clamp(2rem,8vw,3.75rem)] font-light tracking-wide text-warm-white mb-6 leading-tight" style="font-family: var(--font-display)">
        Websites and automations for local businesses.
      </h1>
      <p class="text-warm-white/85 text-lg mb-10 max-w-xl leading-relaxed">
        I help Grand Rapids-area shops, studios, and nonprofits look professional online — and cut the busywork that eats your week.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="#contact"
          class="inline-block bg-garnet hover:bg-garnet/85 text-warm-white text-sm font-medium tracking-wide px-7 py-3 rounded-lg transition-colors"
        >
          Work with me
        </a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="py-16 px-8 max-w-5xl mx-auto scroll-mt-20">
    <h2 class="text-4xl font-light tracking-wide text-near-black mb-10" style="font-family: var(--font-display)">About</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-12 items-center">
      <!-- Photo with offset frame -->
      <div class="flex justify-center sm:order-last">
        <div class="relative w-72 h-72">
          <div class="absolute inset-0 translate-x-3 translate-y-3 border-2 border-garnet rounded-lg"></div>
          <div class="relative bg-dark-olive w-full h-full rounded-lg flex items-center justify-center text-warm-white/40 text-xs tracking-widest uppercase">
            <img src="/profile.jpg" alt="Cass's profile photo" class="rounded-lg object-cover w-full h-full" />
          </div>
        </div>
      </div>
      <!-- Bio with left accent -->
      <div class="border-l-2 border-garnet pl-6">
        <p class="text-near-black leading-relaxed">
          I’m a web developer based in Comstock Park. I build clear, mobile-friendly sites and small automations so West Michigan owners spend less time wrestling with forms and spreadsheets.
        </p>
      </div>
    </div>
  </section>

  <!-- Skills -->
    <h3 class="text-2xl font-light tracking-wide text-near-black mt-16 m-8" style="font-family: var(--font-display)">Skills &amp; Tools</h3>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 ml-8">
      {skillGroups.map(group => (
        <div>
          <p class="text-[0.65rem] tracking-widest uppercase text-near-black/45 mb-3">{group.category}</p>
          <div class="border-t border-garnet mb-4"></div>
          <ul class="space-y-1.5">
            {group.skills.map(skill => (
              <li class="text-sm text-near-black/80">{skill}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="relative pt-20 pb-20 px-8 w-full mx-auto bg-dark-olive overflow-hidden scroll-mt-16" style="clip-path: polygon(0 60px, 100% 0, 100% 100%, 0 100%)">
    <div class="absolute inset-0 opacity-15" style={`background-image: url('${corkboard.src}'); background-repeat: repeat;`} aria-hidden="true"></div>
    <div class="relative z-10 max-w-5xl mx-auto">
      <h2 class="text-6xl font-light tracking-wide text-warm-white mb-8" style="font-family: var(--font-display)"><em>Projects</em></h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 items-stretch">
        <ProjectCard
          name="Automatic Quoting Tool"
          description="Built a website to allow management control over the qouting process while empowering staff with quick turn around times and easy comparisons."
          outcome="Easy management & quick quoting for customers."
          tag="Site"
        />
        <ProjectCard
          name="Automatic balance reporting for a local bank"
          description="Using Power Automate and Excel Scripts to automate archival and report discrepancies."
          outcome="No audit worries & hours saved every week."
          tag="Automation"
        />
        <ProjectCard
          name="Automating download & email of a .PDF from an external site"
          description="Mimicked the login flow of my gyms member portal using Azure Functions to simplify reimbursement reporting."
          outcome="Money saved & deadlines met."
          tag="Automation"
        />
      </div>
    </div>
  </section>

  <!-- Trust band -->
  <section class="bg-near-black px-8 py-12 text-center" aria-label="Service area and turnaround">
    <p class="text-warm-white/80 text-sm sm:text-base leading-relaxed max-w-3xl mx-auto">
      Serving West Michigan from here in Comstock Park. Usually reply within 1-2 business days.
    </p>
  </section>

  <!-- Contact -->
  <section id="contact" class="py-16 px-8 max-w-2xl mx-auto scroll-mt-20">
    <h2 class="text-4xl font-light tracking-wide text-near-black mb-4" style="font-family: var(--font-display)">Contact</h2>
    <p class="text-near-black/60 mb-10 leading-relaxed">
      Tell me about what you’re working on and I’ll get back to you — usually within 1-2 business days.
    </p>
    <ContactForm />
  </section>

</BaseLayout>
