---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import corkboard from '../assets/cork-board.png';
---
<BaseLayout
  title="Contact"
  description="Get in touch with Cass Weiers to discuss your web development or automation project. Based in Comstock Park, MI - available for local and remote work."
>

  <!-- Header banner -->
  <div class="relative bg-dark-olive py-12 px-8 text-center overflow-hidden">
    <div class="absolute inset-0 opacity-15" style={`background-image: url('${corkboard.src}'); background-repeat: repeat;`} aria-hidden="true"></div>
    <div class="relative z-10">
      <h1 class="text-5xl font-light tracking-wide text-warm-white" style="font-family: var(--font-display)">Get in Touch</h1>
      <p class="text-warm-white/70 mt-3 text-sm">Comstock Park, MI - available for local and remote projects</p>
      <p class="text-amber/90 mt-2 text-sm">Usually reply within 1-2 business days.</p>
    </div>
  </div>

  <div class="max-w-2xl mx-auto px-8 py-14">
    <p class="text-near-black/55 mb-10">Tell me about what you're working on and I'll get back to you - usually within 1-2 business days.</p>

    <ContactForm />
  </div>

</BaseLayout>
